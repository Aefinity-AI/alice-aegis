# SAFE-5b: gateway daemon, user unit.
#
# Install: mkdir -p ~/.config/systemd/user && cp this file there, then
#   systemctl --user daemon-reload
#   systemctl --user enable --now cm-gateway.service
#
# Runs `gateway serve` bound to $XDG_RUNTIME_DIR/cm-gateway.sock (mode
# 0600, owner-only). Edit the ExecStart paths below for your box before
# enabling: MODEL/EMBED/VOCAB/agent_trace-bin/allowlist paths are
# deployment-specific and not committed here.
#
# Key material: the allowlist-signing key and the capability-issuing key
# are two SEPARATE files, generated at install time, never committed:
#   install -d -m 700 ~/.config/cm-gateway
#   head -c 32 /dev/urandom > ~/.config/cm-gateway/allowlist.key
#   head -c 32 /dev/urandom > ~/.config/cm-gateway/cap.key
#   chmod 600 ~/.config/cm-gateway/allowlist.key ~/.config/cm-gateway/cap.key
# (or /etc/cm/gateway.key for a system-wide deployment; user mode is the
# default here since this unit runs as a user service).

[Unit]
Description=CM SAFE-5 receipt gateway daemon
After=default.target

[Service]
Type=simple
ExecStart=%h/projects/alice-aegis/demo/agent-trace/gateway/target/release/gateway serve \
    %h/aefinity-artifacts/MODEL.SAF \
    %h/aefinity-artifacts/EMBED.BIN \
    %h/aefinity-artifacts/VOCAB.BIN \
    %h/projects/alice-aegis/aegis-linux/target/release/examples/agent_trace \
    %h/.config/cm-gateway/allowlist.signed \
    %h/.config/cm-gateway/allowlist.key \
    --socket %t/cm-gateway.sock \
    --cap-key-file %h/.config/cm-gateway/cap.key \
    --anchor-every 10 \
    --anchor-file %h/.config/cm-gateway/anchor.log \
    --cap-ttl 60
Restart=on-failure
RestartSec=2
# The daemon itself holds the real credentials (allowlist + capability
# keys) and must NOT be sandboxed as tightly as the agent (it needs to
# exec agent_trace and read the model artifacts) — see ENFORCEMENT.md for
# why a compromised gateway host is the explicitly-out-of-scope residual
# risk this whole layer does not close.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/cm-gateway %t

[Install]
WantedBy=default.target
