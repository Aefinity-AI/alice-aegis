== scale_compare.py ==
# usage: scale_compare.py equal|reciprocal SOURCE OUTPUT
# Reads every *weight_scale tensor from two safetensors headers and compares them by name, exactly.
# equal: output float32 == source value. reciprocal: output float32 == float32(1/source).
import json, struct, sys
def scales(path):
    with open(path, "rb") as f:
        n = struct.unpack("<Q", f.read(8))[0]; h = json.loads(f.read(n)); base = 8 + n; out = {}
        for k, v in h.items():
            if k == "__metadata__" or not k.endswith("weight_scale"): continue
            assert v["dtype"] in ("BF16", "F32"), (k, v["dtype"])
            a, b = v["data_offsets"]; f.seek(base + a); raw = f.read(b - a)
            out[k] = struct.unpack("<f", raw if v["dtype"] == "F32" else b"\0\0" + raw)[0]
    return out
f32 = lambda x: struct.unpack("<f", struct.pack("<f", x))[0]
mode, s, o = sys.argv[1], scales(sys.argv[2]), scales(sys.argv[3])
want = (lambda x: x) if mode == "equal" else (lambda x: f32(1.0 / x))
bad = [k for k in s if k not in o or o[k] != want(s[k])]
k0 = sorted(s)[0]
print(f"mode={mode} source_scales={len(s)} output_scales={len(o)} mismatches={len(bad)} sample {k0}: source={s[k0]} output={o.get(k0)}")
